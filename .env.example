# Copy to .env.local for local development, and set the same names in Vercel → Settings → Environment Variables.
# NEVER commit real values. Every variable is documented in docs/ENVIRONMENT_VARIABLES.md.
# Without the Supabase values the public site runs read-only on content/fallback.json.

# Public site URL (no trailing slash), e.g. https://sheak-fahad.vercel.app
NEXT_PUBLIC_SITE_URL=

# Supabase — database, auth, storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never import in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — contact form notifications and admin replies (server-only)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Fahad AI Assistant (server-only). Without a key the widget runs in labelled "Guide mode".
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=

# Random secrets (32+ random characters each, server-only)
IP_HASH_SALT=
REVALIDATE_SECRET=

# Layout testing only: show DEMO travel rows on ATLAS. Never set in production.
ATLAS_PREVIEW=

# Copy to .env.local and fill in. NEVER commit real values.
# Without Supabase values the public site runs read-only on content/fallback.json.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 7)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never import in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (optional, Resend)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=fahadsheak222@gmail.com
NOTIFY_EMAIL_FROM=

# AI assistant (optional, disabled by default; leave empty to keep it off)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Bot protection (optional, Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Random secrets (generate 32+ random characters each)
IP_HASH_SALT=
REVALIDATE_SECRET=

# Fahad AI Assistant (server-side only — never NEXT_PUBLIC_). Without a key the widget runs in
# clearly-labelled "Guide mode" (answers assembled from verified portfolio data, no AI model).
ANTHROPIC_API_KEY=
# Optional override; default claude-opus-5-5
ASSISTANT_MODEL=

# Layout testing only: show DEMO travel rows on ATLAS. Never set in production.
ATLAS_PREVIEW=
